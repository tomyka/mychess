[Unit]
Description=Prune the rate-limit tables (calls the app's bearer-protected cron route)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=5min
# BETTER_AUTH_URL and CRON_SECRET are read from /srv/mychess/production/.env.
ExecStart=/usr/local/bin/mychess-rate-limit-prune
