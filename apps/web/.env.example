# apps/web's environment. Copy to .env.local for `next dev` / `next start`.
# Production gets its own from the VM's root-only /srv/mychess/production/.env
# (infra/host/production-env.sh, set-secret.sh; infra/compose/production.yml
# passes each variable).

# Postgres the app talks to (packages/db databaseEnvSchema). A local example:
DATABASE_URL=postgres://mychess:mychess@localhost:5432/mychess
# Where the app runs: local | production (src/server/env.ts). Required under
# `next start` (NODE_ENV=production), or the app refuses to start; only
# `next dev` and the tests default an unset value to local.
MYCHESS_ENV=local
# Better Auth: a random string of at least 32 characters, and the app's own URL
# (https in production). The placeholder below is refused: replace
# it, e.g. with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Mail: mailpit locally and in E2E, resend in production.
MAIL_TRANSPORT=mailpit
MAIL_FROM=mychess <noreply@mychess.test>
MAILPIT_URL=http://localhost:8025
# RESEND_API_KEY=  (only with MAIL_TRANSPORT=resend)
# OAuth apps. Lichess needs no secret (PKCE public client). Google is offered
# only when both are set; production requires both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LICHESS_CLIENT_ID=mychess-local
# Local-only persona sign-in (R-73, R-93). Never set on production: it
# refuses to start with it on.
# MYCHESS_TEST_SIGNIN=1
# TEST_SIGNIN_SECRET=
# Local E2E only (#316): with the test sign-in on, the FIDE search reads
# list.txt and lichess_db_broadcast_<YYYY-MM>.pgn.zst from this directory
# instead of database.lichess.org. Production refuses to start with it set.
# FIDE_DUMP_FIXTURE_DIR=
# Key for the admin CLI's audit email hash (R-94); the app itself does not
# read it, only `pnpm --filter @mychess/db admin:grant|admin:disable`. At least
# 32 random characters, e.g. `openssl rand -base64 32`.
# AUDIT_EMAIL_KEY=
