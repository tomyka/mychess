{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["archive/**"],
  "workspaces": {
    ".": {
      "entry": ["quality/**/*.mjs", "scripts/**/*.mjs"]
    },
    "packages/domain": {},
    "packages/chess": {},
    "packages/db": {
      "entry": ["src/{index,migrations}.ts", "src/bin/*.ts"]
    },
    "apps/web": {
      "entry": ["src/app/**/{page,layout,route,not-found,error,loading}.tsx"],
      "vitest": {
        "config": ["vitest.*.config.ts"]
      }
    }
  }
}
