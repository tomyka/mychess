{
  "name": "@mychess/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "node build.mjs",
    "db:generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../apps/web/.env.local dist/migrate.mjs"
  },
  "dependencies": {
    "@mychess/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
