{
	"name": "mychess",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"fide:import": "tsx scripts/import-fide.ts",
		"eco:generate": "tsx scripts/generate-eco-data.ts",
		"anon:audit": "tsx --env-file=.env scripts/anon-audit.ts",
		"anon:purge": "tsx --env-file=.env scripts/anon-purge.ts",
		"schema:check": "tsx --env-file=.env scripts/schema-check.ts",
		"epic95:metrics": "tsx --env-file=.env scripts/epic95-metrics.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.1",
		"@vitest/ui": "^4.1.7",
		"eslint": "^10.8.0",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jsdom": "^27.0.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.106.2",
		"@tanstack/svelte-query": "^6.1.33",
		"@vite-pwa/sveltekit": "^1.1.0",
		"cheerio": "^1.1.0",
		"chess.js": "^1.4.0",
		"chessground": "^9.2.1",
