PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-random-secret-here

# Chess platform OAuth (register apps before use)
# Lichess: https://lichess.org/account/oauth/app  (public client — no secret)
LICHESS_CLIENT_ID=your-lichess-oauth-app-id
LICHESS_REDIRECT_URI=http://localhost:5173/auth/callback/lichess

# Chess.com: https://www.chess.com/club/chess-com-developer-community
CHESSCOM_CLIENT_ID=your-chesscom-client-id
CHESSCOM_CLIENT_SECRET=your-chesscom-client-secret
CHESSCOM_REDIRECT_URI=http://localhost:5173/auth/callback/chesscom

# Google Sign-In (custom flow — Google Cloud Console → APIs & Services → Credentials)
# Add http://localhost:5173/auth/callback/google as an Authorized redirect URI on this client.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google Drive PGN import (client-side picker — see
# docs/superpowers/specs/2026-08-18-google-drive-pgn-import-design.md for full
# Google Cloud Console setup: enable the Drive API + Picker API, and create a
# Picker API key restricted by HTTP referrer). Safe to expose publicly: this
# OAuth client has no secret (PKCE-only), and this is the client's own ID.
PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
PUBLIC_GOOGLE_API_KEY=your-google-picker-api-key

# Shared OAuth state signing secret (min 32 chars random string)
OAUTH_STATE_SECRET=your-random-secret-min-32-chars
